rules_version = '2';
// Regole di sicurezza del database della squadra The Rimineser F.P.
// - Il primo che preme "Sono l'amministratore" diventa amministratore (solo se la squadra non è ancora configurata).
// - Chi si registra non vede nulla finché l'amministratore non lo approva.
// - Iscritti approvati: presenze, eventi, sondaggi (voto). Comunicazioni: Mister, Capitano, Preparatore atletico, Social media manager, amministratore. Formazioni: Capitano, amministratore.
// - Solo l'amministratore approva/rifiuta/modifica gli iscritti e gestisce il gettone delle notifiche.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function teamPath() { return /databases/$(database)/documents/config/team; }
    function isAdmin() { return signedIn() && exists(teamPath()) && request.auth.uid in get(teamPath()).data.coaches; }
    function myPlayer() { return /databases/$(database)/documents/players/$(request.auth.uid); }
    function isMember() { return isAdmin() || (signedIn() && exists(myPlayer()) && get(myPlayer()).data.approved == true); }
    function changes() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function myCat() { return exists(myPlayer()) ? get(myPlayer()).data.get('cat', '') : ''; }
    function canPost() { return isAdmin() || (isMember() && myCat() in ['mister', 'capitano', 'preparatore', 'social']); }   // comunicazioni
    function outKind() { return request.resource.data.get('kind', 'post'); }
    function canLineup() { return isAdmin() || (isMember() && myCat() == 'capitano'); }            // formazioni

    match /config/team {
      // Leggibile da iscritti e amministratore, e da chi non ha ancora un profilo (primo avvio / registrazione).
      // Chi è in attesa o rifiutato NON la legge: la sua schermata si regge sul proprio profilo giocatore.
      allow read: if isMember() || (signedIn() && !exists(myPlayer()));
      allow create: if signedIn() && request.resource.data.coaches == [request.auth.uid];
      // gli iscritti possono cambiare solo il profilo Instagram
      allow update: if isAdmin() || (isMember() && changes().hasOnly(['instagram']));
      allow delete: if false;
    }
    match /posts/{id} {
      allow read: if isMember();
      allow delete: if canPost();
      allow create, update: if canPost() && request.resource.data.text is string && request.resource.data.text.size() < 5000;
    }
    // Formazioni: lockAt = inizio della partita + 5 ore (ms). Fino ad allora le modificano Capitano, amministratore e chi sta
    // facendo lo scouting di quella partita (lock attivo in scout/{id}); poi sono bloccate PER SEMPRE: nessuno (nemmeno
    // l'amministratore) può cambiarle, toglierle o cancellare l'evento.
    function evLocked() { return 'lockAt' in resource.data && request.time.toMillis() >= resource.data.lockAt; }
    function futureLock() { return request.resource.data.get('lockAt', 0) is int && request.resource.data.lockAt > request.time.toMillis(); }
    function scoutPath(id) { return /databases/$(database)/documents/scout/$(id); }
    function scoutHolder(id) { return isMember() && exists(scoutPath(id)) && get(scoutPath(id)).data.get('lock', null) != null
                                      && get(scoutPath(id)).data.lock.uid == request.auth.uid
                                      && get(scoutPath(id)).data.lock.at > request.time - duration.value(2, 'm'); }
    function canEditLineup(id) { return canLineup() || scoutHolder(id); }
    match /events/{id} {
      allow read: if isMember();
      allow delete: if isMember() && !evLocked();
      allow create: if isMember() && (!request.resource.data.keys().hasAny(['lineups', 'lineup', 'lockAt']) || (canEditLineup(id) && futureLock()));
      allow update: if isMember()
                       && (!changes().hasAny(['lineups', 'lineup']) || (canEditLineup(id) && !evLocked() && futureLock()))
                       && (!changes().hasAny(['lockAt']) || (canEditLineup(id) && !evLocked() && futureLock()));
    }
    match /players/{uid} {
      allow read: if isMember() || (signedIn() && request.auth.uid == uid);
      allow create: if isAdmin() || (signedIn() && request.auth.uid == uid && request.resource.data.approved == false
                                     && !('rejected' in request.resource.data)
                                     && !(request.resource.data.get('cat', '') in ['mister', 'capitano', 'preparatore', 'social']));
      // ognuno modifica solo i propri dati personali (non può approvarsi da solo né togliersi un rifiuto)
      // le categorie con permessi speciali le assegna/toglie solo l'amministratore
      allow update: if isAdmin() || (signedIn() && request.auth.uid == uid && changes().hasOnly(['name', 'number', 'role', 'cat', 'nick'])
                                     && (!('cat' in changes()) || !(request.resource.data.cat in ['mister', 'capitano', 'preparatore', 'social'] || resource.data.get('cat', '') in ['mister', 'capitano', 'preparatore', 'social'])));
      allow delete: if isAdmin();
    }
    match /rsvp/{uid} {
      allow read, write: if isMember();
    }
    match /votes/{uid} {
      allow read: if isMember();
      allow write: if isMember() && request.auth.uid == uid;
    }
    match /tokens/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }
    match /outbox/{id} {
      // gli iscritti possono solo mettere in coda nuove notifiche; le invia e le segna il robot
      // ognuno può mettere in coda solo le notifiche che ha il diritto di mandare
      allow create: if isMember() && request.resource.data.sent == false && outKind() in ['post', 'poll', 'lineup', 'remind', 'test']
                       && (!(outKind() in ['post', 'poll']) || canPost())
                       && (outKind() != 'lineup' || canLineup())
                       && (!(outKind() in ['test', 'remind']) || isAdmin());
      allow read, update, delete: if false;
    }
    match /presence/{uid} {
      // "chi è online": ognuno scrive solo il proprio battito (solo l'ora del server); NESSUNO lo legge dall'app:
      // il robot (accesso da server) conta i battiti e pubblica solo il numero in stats/online
      allow read: if false;
      allow create, update: if isMember() && request.auth.uid == uid && request.resource.data.keys().hasOnly(['at']) && request.resource.data.at == request.time;
      allow delete: if signedIn() && request.auth.uid == uid;
    }
    // Visualizzazioni: stats/views-AAAA-MM = {total, dGG}. Ogni iscritto può solo aggiungere +1 al totale del mese
    // e +1 a UN giorno; nel documento non c'è nessun nome né orario. Le legge solo l'amministratore.
    function viewsDoc(id) { return id.matches('views-[0-9]{4}-[0-9]{2}'); }
    function dayKey(k) { return k.matches('d[0-3][0-9]'); }
    // "day" dice quale giorno viene incrementato (es. "d17"): il documento resta solo {total, dGG..., day}
    function viewCreateOk() {
      let d = request.resource.data;
      return dayKey(d.get('day', '')) && d.keys().hasOnly(['total', 'day', d.day]) && d.keys().size() == 3 && d.total == 1 && d[d.day] == 1;
    }
    function viewUpdateOk() {
      let d = request.resource.data;
      let k = d.get('day', '');
      return dayKey(k) && d.diff(resource.data).affectedKeys().hasOnly(['total', 'day', k]) && d.diff(resource.data).affectedKeys().hasAll(['total', k])
             && d.total == resource.data.total + 1 && d[k] == resource.data.get(k, 0) + 1;
    }
    match /stats/{id} {
      // stats/online = {n}: solo quante persone sono online, mai chi (lo scrive il robot)
      allow read: if (id == 'online' && isMember()) || isAdmin();
      allow create: if isMember() && viewsDoc(id) && viewCreateOk();
      allow update: if isMember() && viewsDoc(id) && viewUpdateOk();
      allow delete: if false;
    }
    // Scouting: statistiche della partita, le può segnare qualunque iscritto approvato (anche chi è in panchina)
    function canScout() { return isMember(); }
    // Un solo operatore alla volta: lock = {uid, name, at}. Chi segna lo rinnova ogni 30 s; scaduto da 2 minuti è libero.
    function scLockOf(d) { return d.get('lock', null); }
    function scHeldByMe() { return scLockOf(resource.data) != null && scLockOf(resource.data).uid == request.auth.uid; }
    function scFree() { return scLockOf(resource.data) == null || scLockOf(resource.data).at < request.time - duration.value(2, 'm'); }
    function scLockOk(l) { return l != null && l.keys().hasOnly(['uid', 'name', 'at']) && l.uid == request.auth.uid && l.at == request.time && l.name is string && l.name.size() < 60; }
    function scFields() { return request.resource.data.keys().hasOnly(['acts', 'half', 'base', 'start', 'lock', 'updatedAt'])
                                  && request.resource.data.get('acts', []) is list && request.resource.data.get('acts', []).size() <= 3000; }
    match /scout/{eid} {
      allow read: if canScout();
      allow create: if canScout() && scFields() && (scLockOf(request.resource.data) == null || scLockOk(scLockOf(request.resource.data)));
      allow update: if canScout() && scFields() && (
          // prendere o rinnovare il lock: libero, scaduto o già mio
          (scLockOf(request.resource.data) != scLockOf(resource.data) && scLockOf(request.resource.data) != null && scLockOk(scLockOf(request.resource.data)) && (scFree() || scHeldByMe()))
          // lasciare il lock (solo se è mio)
          || (scLockOf(request.resource.data) == null && scLockOf(resource.data) != null && scHeldByMe())
          // qualunque altra scrittura (azioni, cronometro): solo chi ha il lock, senza cambiarlo
          || (scLockOf(request.resource.data) == scLockOf(resource.data) && scHeldByMe()));
      allow delete: if isAdmin();
    }
    match /private/{id} {
      // gettone GitHub: solo l'amministratore
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    match /league/{id} {
      allow read: if isMember();
      allow write: if false;
    }
    match /robot/{id} {
      allow read, write: if false;   // solo il robot (accesso da server)
    }
  }
}
